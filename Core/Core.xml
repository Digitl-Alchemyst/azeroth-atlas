<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- Load order matters: Bootstrap creates the AzerothAtlas global,
         Logger and EventBus hang off it, then Module builds on those,
         and SavedVariables/SlashCommands subscribe to the lifecycle
         events Bootstrap fires last. -->
    <Script file="Bootstrap.lua" />
    <Script file="Logger.lua" />
    <Script file="EventBus.lua" />
    <Script file="Module.lua" />
    <Script file="SavedVariables.lua" />
    <Script file="SlashCommands.lua" />
</Ui>
