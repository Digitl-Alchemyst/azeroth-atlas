<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- Fonts/Skin/Button/Window: the ported Nx.Window chrome used by
         the minimap window. Then Widget/Mixins/SmallWindow: the
         simplified chrome used by the Settings window. Order matters -
         each file depends on the ones before it (see each file's own
         header comment for its specific dependencies). -->
    <Script file="Fonts.lua" />
    <Script file="Skin.lua" />
    <Script file="Button.lua" />
    <Script file="Window.lua" />

    <Script file="Widget.lua" />
    <Script file="Mixins\Draggable.lua" />
    <Script file="Mixins\Resizable.lua" />
    <Script file="SmallWindow.lua" />

    <!-- Build-order step 13: Style tab support. TabBar/StyleOptions
         need AlchemyGPS.UI (created by Widget.lua) but not SmallWindow. -->
    <Script file="TabBar.lua" />
    <Script file="StyleOptions.lua" />

    <!-- 2026-11-17: theme parts bin for the final theming stage (data only). -->
    <Script file="ThemeLibrary.lua" />
</Ui>
