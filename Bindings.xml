<Bindings>
    <!-- Clicks the hidden secure button Quest\QuestItems.lua keeps aimed
         at the item of the nearest tracked quest. The menu text is set
         there (BINDING_HEADER_AZEROTHATLAS / BINDING_NAME_...). -->
    <Binding name="CLICK AzerothAtlasQuestItemNearest:LeftButton" header="AZEROTHATLAS" category="ADDONS" />
    <!-- M / L (Map\MinimapWindow.lua's ApplyKeys puts these on the M and
         L keys as override bindings; they can also be bound to any other
         key from the game's Key Bindings menu). Names are set in
         MinimapWindow.lua. -->
    <Binding name="AZEROTHATLAS_TOGGLEMAP" category="ADDONS">
        AzerothAtlas_ToggleMapSize()
    </Binding>
    <Binding name="AZEROTHATLAS_QUESTLIST" category="ADDONS">
        AzerothAtlas_ToggleQuestList()
    </Binding>
</Bindings>
