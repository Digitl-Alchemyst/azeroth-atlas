<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- MinimapWindow.lua first: defines the Module:New("MinimapWindow", ...)
         instance NativeMinimapHide.lua's caller (OnEnable) reads DB from.
         Later build-order phases append ZoomController/ScrollScale/
         MiniMap/Coords/FrameToWorld here as they're ported. -->
    <!-- Pure data, no dependencies - loads first so MinimapEngine.lua's
         AlchemyGPS.Map alias (build-order step 8) finds it already
         populated, whichever of the two happens to load first. -->
    <Script file="Data\NxMapData.lua" />
    <!-- Build-order step 8b: the real-terrain detail-tile system
         (shows once zoomed in past NXDetailScale, see
         MinimapEngine.lua's UpdateMiniFrames). MinimapTiles.lua is
         pure data (no dependency); MinimapBindings.lua needs both it
         (CamelotKalMapBlks/CamelotEkMapBlks) and NxMapData.lua
         (MapWorldInfo/MapInfo) already loaded, so it goes last of the
         three. MinimapRuntime.lua just defines methods, no load-time
         dependency on the other two. -->
    <Script file="Data\MinimapTiles.lua" />
    <Script file="Data\MinimapRuntime.lua" />
    <Script file="Data\MinimapBindings.lua" />
    <!-- Build-order step 9b: static service-icon data (mailbox/
         innkeeper), pure data, no dependencies. -->
    <Script file="Data\GuideMailbox.lua" />
    <Script file="Data\GuideInnkeeper.lua" />
    <!-- Build-order step 9e: static Wowhead gathering-node data (herb/
         mining/fish/treasure), pure data, no dependencies. Herb/Mining/
         Treasure ported from the standalone GatherMate2_Data addon's
         own "Forever"-flavor pack (tailored to this exact server);
         Fish ported from Carbonite.Gathermate2_Data's "camelot" pack
         instead, since the Forever pack's own FishData.lua is empty -
         see MinimapEngine.lua's own header comment for the full
         reasoning. -->
    <Script file="Data\GatherHerb.lua" />
    <Script file="Data\GatherMining.lua" />
    <Script file="Data\GatherFish.lua" />
    <Script file="Data\GatherTreasure.lua" />
    <!-- Build-order step 9f: per-species name/icon/skill-level data
         for the same four categories, pure data, no dependencies. -->
    <Script file="Data\GatherNodeInfo.lua" />
    <Script file="MinimapWindow.lua" />
    <Script file="NativeMinimapHide.lua" />
    <Script file="ScrollScale.lua" />
    <Script file="ZoomController.lua" />
    <Script file="MinimapEngine.lua" />
    <Script file="MinimapDock.lua" />
    <Script file="MapContextMenu.lua" />
</Ui>
