<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- The questing companion: tracker window, map pins, routing arrow.
         Loads after Map\Map.xml (everything here converts positions
         through AlchemyGPS.Map:GetWorldPos) and after UI\UI.xml (the
         tracker uses the small-window chrome).

         Data first. Generated by Tools\gen_quest_data.py from
         Carbonite.Quests' camelot data - pure data, no dependencies.
         Each QuestDB file only registers a builder function; the rows
         are created after login by QuestCatalog.lua. -->
    <Script file="Data\QuestDB1.lua" />
    <Script file="Data\QuestDB2.lua" />
    <Script file="Data\QuestDB3.lua" />
    <Script file="Data\QuestDB4.lua" />
    <Script file="Data\QuestDB5.lua" />
    <Script file="Data\QuestDB6.lua" />
    <Script file="Data\QuestDBExtras.lua" />
    <!-- Quests QuestieDB has that the Carbonite data lacks (this server's
         own among them), in the same row shape, plus Questie's quest
         blacklist. Generated by Tools\gen_quest_import.py; adds to the
         Names / StartAlts / EndAlts tables above, so it loads after them. -->
    <Script file="Data\QuestDBImported.lua" />
    <!-- Generated from QuestieDB by Tools\gen_quest_rules.py: who can
         pick a quest up, items that start quests, patrol paths, quest
         items. Plain strings, parsed on demand by QuestRules.lua. -->
    <Script file="Data\QuestDBRules.lua" />
    <!-- Hand-maintained, not generated: dungeon and giver/turn-in
         positions for this server's newest quests (The Drowned City),
         which the generated data above has no location for. -->
    <Script file="Data\QuestDBManual.lua" />

    <!-- Order matters below: each file reads the ones above it at file
         scope. QuestApi (no dependencies) -> Quest (the module shell,
         settings) -> QuestCatalog (the database) -> QuestState (the
         live log) -> QuestRouting (needs Api + Catalog) -> the pieces
         that consume routing. -->
    <Script file="QuestApi.lua" />
    <Script file="Quest.lua" />
    <Script file="QuestCatalog.lua" />
    <Script file="QuestRules.lua" />
    <Script file="QuestState.lua" />
    <Script file="QuestParty.lua" />
    <Script file="QuestRouting.lua" />
    <Script file="SuperTrack.lua" />
    <Script file="TrackerHider.lua" />
    <Script file="QuestPins.lua" />
    <Script file="QuestOverlay.lua" />
    <Script file="QuestItems.lua" />
    <Script file="QuestMenu.lua" />
    <Script file="QuestTracker.lua" />
    <Script file="QuestList.lua" />
    <!-- 2026-11-18: the quest text side panel. -->
    <Script file="QuestDetails.lua" />
    <!-- 2026-11-18: quest-complete sound, progress messages. -->
    <Script file="QuestNotify.lua" />
    <!-- 2026-11-18: quest lines on mob and item tooltips. -->
    <Script file="QuestTooltips.lua" />
    <Script file="HUDArrow.lua" />
</Ui>
